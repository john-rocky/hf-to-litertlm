{%- macro format_content(content) -%}
    {%- if content is string -%}
        {{- content -}}
    {%- elif content is sequence -%}
        {%- for item in content -%}
            {%- if item['type'] == 'text' -%}
                {{- item['text'] -}}
            {%- elif item['type'] == 'tool_response' -%}
                {%- if item['response'] is string -%}
                    {{- item['response'] -}}
                {%- else -%}
                    {{- item['response'] | tojson -}}
                {%- endif -%}
            {%- endif -%}
        {%- endfor -%}
    {%- endif -%}
{%- endmacro -%}
{%- macro json4(x, ind) -%}
    {%- if x is mapping -%}
        {%- if x | length == 0 -%}
            {{- '{}' -}}
        {%- else -%}
            {{- '{
' -}}
            {%- for k, v in x | items -%}
                {{- ind + '    ' + (k | tojson) + ': ' + json4(v, ind + '    ') -}}
                {%- if not loop.last -%}
                    {{- ',' -}}
                {%- endif -%}
                {{- '
' -}}
            {%- endfor -%}
            {{- ind + '}' -}}
        {%- endif -%}
    {%- elif x is string -%}
        {{- x | tojson -}}
    {%- elif x is sequence -%}
        {%- if x | length == 0 -%}
            {{- '[]' -}}
        {%- else -%}
            {{- '[
' -}}
            {%- for v in x -%}
                {{- ind + '    ' + json4(v, ind + '    ') -}}
                {%- if not loop.last -%}
                    {{- ',' -}}
                {%- endif -%}
                {{- '
' -}}
            {%- endfor -%}
            {{- ind + ']' -}}
        {%- endif -%}
    {%- else -%}
        {{- x | tojson -}}
    {%- endif -%}
{%- endmacro -%}
{%- if tools %}
    {{- '<|start_of_role|>available_tools<|end_of_role|>
' }}
    {%- for tool in tools %}
    {{- json4(tool, '') }}
    {%- if not loop.last %}
        {{- '

' }}
    {%- endif %}
    {%- endfor %}
    {{- '<|end_of_text|>
' }}
{%- endif %}
{%- for message in messages %}
    {%- if message['role'] == 'system' %}
    {{- '<|start_of_role|>system<|end_of_role|>' + format_content(message['content']) + '<|end_of_text|>
' }}
    {%- elif message['role'] == 'user' %}
    {{- '<|start_of_role|>user<|end_of_role|>' + format_content(message['content']) + '<|end_of_text|>
' }}
    {%- elif message['role'] == 'assistant' %}
    {{- '<|start_of_role|>assistant<|end_of_role|>'  + format_content(message['content']) + '<|end_of_text|>
' }}
    {%- elif message['role'] == 'assistant_tool_call' %}
    {{- '<|start_of_role|>assistant<|end_of_role|><|tool_call|>' + format_content(message['content']) + '<|end_of_text|>
' }}
    {%- elif message['role'] == 'tool_response' %}
    {{- '<|start_of_role|>tool_response<|end_of_role|>' + format_content(message['content']) + '<|end_of_text|>
' }}
    {%- elif message['role'] == 'tool' %}
    {{- '<|start_of_role|>tool_response<|end_of_role|>' + format_content(message['content']) + '<|end_of_text|>
' }}
    {%- endif %}
    {%- if loop.last and add_generation_prompt %}
    {{- '<|start_of_role|>assistant<|end_of_role|>' }}
    {%- endif %}
{%- endfor %}
