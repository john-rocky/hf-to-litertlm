+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+# ==============================================================================
+"""Patch for DeepSeek-V2 (MLA with complex-valued RoPE).
+
+DeepSeek-V2 expresses RoPE with complex tensors: the rotary embedding builds
+`freqs_cis = torch.polar(ones, freqs)` (a complex tensor) and `apply_rotary_emb`
+applies it via `view_as_complex(x) * freqs_cis` then `view_as_real(...)`. While
+these complex ops can be lowered to MLIR, the tflite flatbuffer has no general
+complex tensor type, so export fails at flatbuffer serialization
+(`tf.Complex -> tensor<...xcomplex<f32>>`). DeepSeek-V3 avoids this by using a
+real `rotate_half` formulation, which is why V3 converts and V2 does not.
+
+The fix swaps in the algebraically-identical real-arithmetic form (the interleaved
+GPT-J convention V2 uses): the rotary embedding returns a real `(cos, sin)` pair
+and the rotary application does the complex multiply with real ops only. Output is
+bit-equivalent to the complex path (a complex multiply expanded as
+`(a + bi)(cos + i sin) = (a*cos - b*sin) + i(a*sin + b*cos)`).
+"""
+
+import contextlib
+
+import torch
+from litert_torch.generative.export_hf.model_ext import patches as patches_lib
+from transformers.models.deepseek_v2 import modeling_deepseek_v2
+
+
+def _apply_rotary_emb_real(xq, xk, rope):
+  """Real-arithmetic replacement for `modeling_deepseek_v2.apply_rotary_emb`.
+
+  Args:
+    xq, xk: tensors `[..., dim]` whose last axis holds interleaved (real, imag)
+      pairs, matching the stock `view_as_complex(x.reshape(..., -1, 2))`.
+    rope: real tensor `[batch, seq, dim // 2, 2]` holding `(cos, sin)` (scaled by
+      `attention_scaling`), as produced by the patched rotary embedding.
+
+  Returns:
+    (xq_out, xk_out) with the same interleaved layout as the stock complex path.
+  """
+  cos = rope[..., 0].unsqueeze(1)  # [batch, 1, seq, dim // 2]
+  sin = rope[..., 1].unsqueeze(1)
+
+  def rotate(x):
+    x = x.reshape(*x.shape[:-1], -1, 2)
+    a = x[..., 0]
+    b = x[..., 1]
+    out_real = a * cos - b * sin
+    out_imag = a * sin + b * cos
+    return torch.stack((out_real, out_imag), dim=-1).flatten(3)
+
+  return rotate(xq), rotate(xk)
+
+
+class PatchedDeepseekV2RotaryEmbedding(modeling_deepseek_v2.DeepseekV2RotaryEmbedding):
+  """Rotary embedding that returns a real `(cos, sin)` pair instead of `polar`.
+
+  Class swap (like LFM2/Qwen3.5/Granite-4-h): the instance built during
+  `from_pretrained` carries the patched behaviour, which persists into the later
+  `torch.export` even though the load-time patch context has already exited.
+  """
+
+  @torch.no_grad()
+  @modeling_deepseek_v2.dynamic_rope_update  # keep dynamic-RoPE handling (no-op for default/yarn)
+  def forward(self, x, position_ids):
+    inv_freq_expanded = (
+        self.inv_freq[None, :, None].float().expand(position_ids.shape[0], -1, 1)
+    )
+    position_ids_expanded = position_ids[:, None, :].float()
+    # The stock forward forces float32 via maybe_autocast; under torch.export no
+    # autocast is active, so plain float32 math is equivalent.
+    freqs = (
+        inv_freq_expanded.to(x.device) @ position_ids_expanded
+    ).transpose(1, 2)
+    cos = torch.cos(freqs) * self.attention_scaling
+    sin = torch.sin(freqs) * self.attention_scaling
+    return torch.stack((cos, sin), dim=-1)
+
+
+class PatchedDeepseekV2Attention(modeling_deepseek_v2.DeepseekV2Attention):
+  """Attention that applies RoPE with the real-arithmetic helper.
+
+  `apply_rotary_emb` is a module-level function referenced from the stock
+  `forward`, so it cannot be redirected by a class method. Instead, install the
+  real helper as the module symbol for the duration of `super().forward()` (it is
+  resolved — and traced — exactly when the stock forward calls it) and restore it
+  afterwards, avoiding a verbatim copy of the long attention forward.
+  """
+
+  def forward(self, *args, **kwargs):
+    original = modeling_deepseek_v2.apply_rotary_emb
+    modeling_deepseek_v2.apply_rotary_emb = _apply_rotary_emb_real
+    try:
+      return super().forward(*args, **kwargs)
+    finally:
+      modeling_deepseek_v2.apply_rotary_emb = original
+
+
+@patches_lib.register_patch(["deepseek_v2"])
+@contextlib.contextmanager
+def deepseek_v2_litert_patch():
+  print("DeepSeek-V2 (complex-RoPE) patch applied.")
+  original_rotary = modeling_deepseek_v2.DeepseekV2RotaryEmbedding
+  original_attention = modeling_deepseek_v2.DeepseekV2Attention
+  modeling_deepseek_v2.DeepseekV2RotaryEmbedding = PatchedDeepseekV2RotaryEmbedding
+  modeling_deepseek_v2.DeepseekV2Attention = PatchedDeepseekV2Attention
+  try:
+    yield
+  finally:
+    modeling_deepseek_v2.DeepseekV2RotaryEmbedding = original_rotary
+    modeling_deepseek_v2.DeepseekV2Attention = original_attention
