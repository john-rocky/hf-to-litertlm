+"""Zamba2 (Mamba2 backbone + shared/tied transformer blocks) LiteRT export patch.
+
+`Zamba2MambaMixer.torch_forward`'s scan body is granite's Mamba2 SSD in a
+different spelling — the same five contractions with permuted-equivalent
+states math (diffed against granitemoehybrid, 2026-08-14) — and its wrapper is
+NemotronH's shape in every load-bearing way:
+
+1. **dt clamp is min-only** (`torch.clamp(dt, self.time_step_min)`, the max
+   clamp is commented out upstream). Pads must be forced to dt = 0 AFTER the
+   clamp or every pad step decays the state by `exp(time_step_min * A)` — the
+   NemotronH floor trap. NemotronH's folded forward already encodes exactly
+   this (min-only clamp + post-clamp dt masking), and every mixer attribute it
+   touches has the same name on Zamba2MambaMixer, so the forward is reused
+   VERBATIM (bamba-style thin wrapper; source anchors asserted below).
+2. The in_proj split carries two width-0 `d_mlp` slices (`projection_size =
+   intermediate + conv_dim + heads` forces `d_mlp == 0` on every published
+   Zamba2 config) — asserted at patch time; the port uses the 3-way split.
+3. The gate tail is `Zamba2RMSNormGated` (grouped RMS; group_count ==
+   n_groups) — reused as the module instance, exactly like granite's.
+
+The shared-trunk / LoRA side needs NO patch: each of the `hybrid` positions
+holds its own `Zamba2AttentionDecoderLayer` instance with weights tied to the
+first (torch.export lifts tied storage once), the per-position adapters are
+selected by a Python int (`layer_dic[layer_idx]`) which is static at trace
+time, and `Zamba2Model.forward` passes `**kwargs` through to the attention
+interface (unlike FalconH1 there is no ts_idx re-injection to do). Mixer
+construction is by module-global name at model-build time (no import-time
+MIXER_TYPES registry), so the class swap reaches the instances — and the
+patched model forward still counts patched mixers and fails loudly if the
+swap ever stops reaching them.
+
+Cache side (core/cache.py): `linear_attention` layers route to
+LiteRTLMMambaCacheLayer via the `n_mamba_heads` dispatch key, `hybrid` layers
+to LiteRTLMHybridCacheLayer; both `create_from_config`s read the Zamba2
+vocabulary (`n_mamba_heads` / `mamba_headdim` / `mamba_ngroups`).
+
+**num_mem_blocks > 1 (2.7B/7B) upstream structure bug**: upstream
+`Zamba2Model.get_layers` assigns `block_id = layer_id % num_mem_blocks` (the
+GLOBAL layer index) while both the checkpoint layout and the weight-tie cycle
+follow the hybrid OCCURRENCE order (`hybrid_layer_ids.index(layer_id) %
+num_mem_blocks`). On 2.7B (`hybrid_layer_ids = [6,12,18,24,30,36,42,47,51]` —
+even until 42, then 47/51) the two conventions disagree, the two unique blocks
+(layers 6 and 12, both `layer_id % 2 == 0`) come out structurally identical
+(both holding the even-index MLP-adapter slots), and `post_init` raises at
+tie-key expansion: the checkpoint stores layers.6 adapters at hybrid orders
+{0,2,4,6,8} and layers.12 at {1,3,5,7}. `_get_layers_hybrid_order` below is
+the upstream method verbatim with `block_id` computed from the hybrid order
+counter — which makes structure, tie cycle, and checkpoint agree (verified
+key-exact against the 2.7B safetensors index). num_mem_blocks == 1 (1.2B) is
+unaffected (block_id is 0 either way). Upstream main still has the bug as of
+2026-08-14 (anchor-asserted below so a future upstream fix surfaces here).
+"""
+
+import contextlib
+import inspect
+from itertools import cycle
+
+import torch
+from litert_torch.generative.export_hf.model_ext import patches as patches_lib
+from litert_torch.generative.export_hf.model_ext.nemotron_h import (
+    patch as nemotron_patch,
+)
+from transformers.models.zamba2 import modeling_zamba2
+
+nn = torch.nn
+F = torch.nn.functional
+
+
+def _get_layers_hybrid_order(self):
+  """Upstream `Zamba2Model.get_layers` with block_id in hybrid-order convention.
+
+  Verbatim copy of transformers 5.14.1 except the marked line: `block_id`
+  counts hybrid OCCURRENCES (matching the checkpoint layout and the tie
+  cycle), not global layer ids. See module docstring.
+  """
+  layers = []
+  self._tied_weights_keys = {}
+  self.first_transformer_layer_id = 0
+  unique_hybrid_blocks = []
+  hybrid_order = 0
+
+  for layer_id, layer_type in enumerate(self.layers_block_type):
+    mamba_layer = modeling_zamba2.Zamba2MambaDecoderLayer(
+        self.config, layer_idx=layer_id
+    )
+    if layer_type == "hybrid":
+      prefix_pattern = f"layers.{layer_id}.shared_transformer"
+
+      # Zamba ties Hybrid module weights by repeating blocks after every
+      # `num_mem_blocks`. So if `num_mem_blocks=2`, the blocks looks like
+      # [1, 2, 1, 2, 1, 2] where all "ones" share the same set of weights.
+      if (
+          not isinstance(unique_hybrid_blocks, list)
+          or len(unique_hybrid_blocks) >= self.config.num_mem_blocks
+      ):
+        if isinstance(unique_hybrid_blocks, list):
+          unique_hybrid_blocks = cycle(unique_hybrid_blocks)
+        target_pattern = next(unique_hybrid_blocks)
+        self._tied_weights_keys.update({prefix_pattern: target_pattern})
+      else:
+        # Store source patterns to which the subsequent modules will be tied
+        unique_hybrid_blocks.append(prefix_pattern)
+
+      # FIX (upstream: `layer_id % num_mem_blocks`): hybrid-order convention.
+      block_id = hybrid_order % self.config.num_mem_blocks
+      hybrid_order += 1
+      attn_block = modeling_zamba2.Zamba2AttentionDecoderLayer(
+          self.config, block_id=block_id
+      )
+      linear_layer = nn.Linear(
+          self.config.hidden_size, self.config.hidden_size, bias=False
+      )
+      layers.append(
+          modeling_zamba2.Zamba2HybridLayer(attn_block, linear_layer, mamba_layer)
+      )
+    else:
+      layers.append(mamba_layer)
+  return nn.ModuleList(layers)
+
+
+class PatchedZamba2Model(modeling_zamba2.Zamba2Model):
+  """Export-friendly Zamba2 model (class swap; persists on the instance)."""
+
+  get_layers = _get_layers_hybrid_order
+
+  def train(self, mode: bool = True):
+    # One-time real-buffer check on the eval() transition (outside tracing,
+    # after weights are loaded): rotary inv_freq is a non-persistent buffer
+    # computed in __init__ — the classic meta-load zeroing candidate. A zeroed
+    # inv_freq makes every shared-attention position embedding constant and
+    # degrades generation silently.
+    if not mode and not getattr(self, "_litert_invfreq_checked", False):
+      rot = getattr(self, "rotary_emb", None)
+      inv = getattr(rot, "inv_freq", None) if rot is not None else None
+      if (inv is not None and isinstance(inv, torch.Tensor) and not inv.is_meta
+          and float(inv.abs().max()) == 0.0):
+        raise AssertionError(
+            "Zamba2 rotary inv_freq is all-zero (non-persistent buffer lost in"
+            " loading) - the export would be silently degenerate."
+        )
+      self._litert_invfreq_checked = True
+    return super().train(mode)
+
+  def forward(self, input_ids=None, **kwargs):
+    # Engine pads prefill chunks with token id 0; stash the per-position valid
+    # mask on every mamba mixer (the mixers receive attention_mask=None in
+    # transformers >= 5.14).
+    valid = (input_ids != 0).to(torch.float32) if input_ids is not None else None
+    n_patched = 0
+    for module in self.modules():
+      if isinstance(module, PatchedZamba2MambaMixer):
+        module._litert_valid = valid
+        n_patched += 1
+    if n_patched == 0:
+      # The NemotronH lesson: if construction ever stops resolving the
+      # module-global class (e.g. an upstream registry appears), the reference
+      # scan would trace with no pad guard and every parity gate would still
+      # pass. Fail loudly instead.
+      raise AssertionError(
+          "No patched Zamba2 mixers found on the model - the class swap did"
+          " not reach the instances."
+      )
+    return super().forward(input_ids=input_ids, **kwargs)
+
+
+class PatchedZamba2MambaMixer(modeling_zamba2.Zamba2MambaMixer):
+  # NemotronH's folded rank<=4 SSD forward applies verbatim: identical mixer
+  # attribute names, identical 3-way split (d_mlp == 0), identical min-only dt
+  # clamp with post-clamp pad masking, identical conv/cache contract, and the
+  # gate tail is `self.norm(y, gate)` in both. Source anchors below pin the
+  # upstream scan to the shape this reuse assumes.
+  torch_forward = nemotron_patch._folded_torch_forward_nemotron
+
+
+def _assert_projection_layout():
+  """The 3-way split is valid only while in_proj carries no MLP slices."""
+  src = inspect.getsource(modeling_zamba2.Zamba2MambaMixer.__init__)
+  if ("projection_size = self.intermediate_size + self.conv_dim +"
+      " self.num_heads" not in src):
+    raise AssertionError(
+        "Zamba2MambaMixer.in_proj projection layout changed upstream; re-check"
+        " the d_mlp slices before using the 3-way split."
+    )
+
+
+def _assert_get_layers_convention():
+  """Anchor the upstream get_layers to the shape our fixed copy assumes.
+
+  If the block_id line disappears, upstream fixed (or changed) the
+  num_mem_blocks > 1 structure bug - re-diff `_get_layers_hybrid_order`
+  against the new upstream before exporting.
+  """
+  src = inspect.getsource(modeling_zamba2.Zamba2Model.get_layers)
+  for anchor in (
+      "block_id = layer_id % self.config.num_mem_blocks",
+      "unique_hybrid_blocks = cycle(unique_hybrid_blocks)",
+      "self._tied_weights_keys.update({prefix_pattern: target_pattern})",
+      "Zamba2HybridLayer(attn_block, linear_layer, mamba_layer)",
+  ):
+    if anchor not in src:
+      raise AssertionError(
+          f"Zamba2Model.get_layers lost anchor {anchor!r}; upstream changed"
+          " (possibly fixing the num_mem_blocks block_id bug) - re-diff"
+          " _get_layers_hybrid_order before exporting."
+      )
+
+
+def _assert_scan_body_unchanged():
+  """Anchor the upstream scan to the shape the NemotronH folded reuse assumes."""
+  src = inspect.getsource(modeling_zamba2.Zamba2MambaMixer.torch_forward)
+  for anchor in (
+      # min-only clamp, both paths (the max clamp stays commented out)
+      "dt = torch.clamp(dt, self.time_step_min)",
+      # the chunked scan is still the granite-family SSD
+      "decay_chunk = torch.exp(segment_sum(nn.functional.pad(A_cumsum[:, :, :, -1], (1, 0))))",
+      "B_decay_contraction",
+      # cache convention still (b, H, P, N) with a plain recurrent store
+      "cache_params.update_recurrent_state(ssm_state, self.layer_idx)",
+  ):
+    if anchor not in src:
+      raise AssertionError(
+          f"Zamba2MambaMixer.torch_forward lost anchor {anchor!r}; the"
+          " upstream scan changed - re-verify the folded port before"
+          " exporting."
+      )
+
+
+def _selfcheck_folded_zamba2(tol=2e-4):
+  """Run the reused folded scan against the installed Zamba2 reference."""
+  from transformers.models.zamba2.configuration_zamba2 import Zamba2Config
+
+  torch.manual_seed(0)
+  cfg = Zamba2Config(
+      hidden_size=64,
+      num_hidden_layers=2,
+      layers_block_type=["mamba", "hybrid"],
+      n_mamba_heads=8,
+      mamba_expand=2,
+      mamba_d_state=16,
+      mamba_d_conv=4,
+      mamba_ngroups=2,
+      chunk_size=8,
+      use_mamba_kernels=False,
+  )
+  layer = modeling_zamba2.Zamba2MambaMixer(cfg, layer_idx=0).eval().float()
+  worst = 0.0
+  for seq in (16, 13):
+    x = torch.randn(1, seq, cfg.hidden_size)
+    with torch.no_grad():
+      ref = modeling_zamba2.Zamba2MambaMixer.torch_forward(layer, x)
+      new = nemotron_patch._folded_torch_forward_nemotron(layer, x)
+    worst = max(worst, (ref - new).abs().max().item() / ref.abs().max().item())
+  if worst > tol:
+    raise AssertionError(
+        "Zamba2 folded SSD disagrees with the installed transformers"
+        f" implementation (relative max|diff| {worst:.2e} > {tol:.0e})."
+    )
+  return worst
+
+
+@patches_lib.register_patch(["zamba2"])
+@contextlib.contextmanager
+def zamba2_litert_patch():
+  _assert_projection_layout()
+  _assert_get_layers_convention()
+  _assert_scan_body_unchanged()
+  rel = _selfcheck_folded_zamba2()
+  print(
+      "Zamba2 patch applied (NemotronH folded rank<=4 SSD reused verbatim:"
+      f" pad guard + min-only dt clamp; self-check rel {rel:.1e})."
+  )
+  original_model = modeling_zamba2.Zamba2Model
+  original_mixer = modeling_zamba2.Zamba2MambaMixer
+  modeling_zamba2.Zamba2Model = PatchedZamba2Model
+  modeling_zamba2.Zamba2MambaMixer = PatchedZamba2MambaMixer
+  try:
+    yield
+  finally:
+    modeling_zamba2.Zamba2Model = original_model
+    modeling_zamba2.Zamba2MambaMixer = original_mixer
