+)
+from transformers.models.bamba import modeling_bamba
+from transformers.models.granitemoehybrid import modeling_granitemoehybrid
+
+
+class PatchedBambaModel(modeling_bamba.BambaModel):
+  """Export-friendly Bamba text model (class swap; persists on the instance)."""
+
+  def forward(self, input_ids=None, **kwargs):
+    # Engine pads prefill chunks with token id 0; stash the per-position valid
+    # mask on every mixer instance (the mixers receive attention_mask=None in
+    # transformers 5.14, so torch_forward reads `self._litert_valid` instead).
+    valid = (input_ids != 0).to(torch.float32) if input_ids is not None else None
+    for module in self.modules():
+      if isinstance(module, PatchedBambaMixer):
+        module._litert_valid = valid
+    return super().forward(input_ids=input_ids, **kwargs)
+
+
+class PatchedBambaMixer(modeling_bamba.BambaMixer):
+  torch_forward = granite_patch._folded_torch_forward
+
+
+def _assert_same_scan_source():
+  """The reuse contract: bamba's scan must still BE granite's scan."""
+  src_b = inspect.getsource(modeling_bamba.BambaMixer.torch_forward)
+  src_g = inspect.getsource(
+      modeling_granitemoehybrid.GraniteMoeHybridMambaLayer.torch_forward
+  )
+  if src_b != src_g:
+    raise AssertionError(
+        "BambaMixer.torch_forward no longer matches "
+        "GraniteMoeHybridMambaLayer.torch_forward in the installed "
+        "transformers; the granite folded scan can no longer be reused "
+        "blindly. Diff the two and give bamba its own derivation."
+    )
+
+
+def _selfcheck_folded_bamba(tol=2e-4):
+  """Run the folded scan against the installed BambaMixer on bamba's own class."""
+  from transformers.models.bamba.configuration_bamba import BambaConfig
+
+  torch.manual_seed(0)
+  cfg = BambaConfig(
+      hidden_size=64,
+      num_hidden_layers=1,
+      mamba_n_heads=8,
+      mamba_d_head=16,
+      mamba_d_state=16,
+      mamba_expand=2,
+      mamba_chunk_size=8,
+      mamba_n_groups=2,
+  )
+  layer = modeling_bamba.BambaMixer(cfg, layer_idx=0).eval().float()
+  worst = 0.0
+  for seq in (16, 13):
+    x = torch.randn(1, seq, cfg.hidden_size)
+    with torch.no_grad():
+      ref = modeling_bamba.BambaMixer.torch_forward(layer, x)
+      new = granite_patch._folded_torch_forward(layer, x)
+    worst = max(worst, (ref - new).abs().max().item() / ref.abs().max().item())
+  if worst > tol:
+    raise AssertionError(
+        "bamba folded SSD disagrees with the installed transformers "
+        f"implementation (relative max|diff| {worst:.2e} > {tol:.0e})."
+    )
+  return worst
+
+
+@patches_lib.register_patch(["bamba"])
+@contextlib.contextmanager
+def bamba_litert_patch():
+  _assert_same_scan_source()
+  rel = _selfcheck_folded_bamba()
+  print(
+      "Bamba patch applied (granite folded rank<=4 SSD + pad guard, "
+      f"source-identity asserted; self-check rel {rel:.1e})."
+  )
+  original_model = modeling_bamba.BambaModel
+  original_mixer = modeling_bamba.BambaMixer
+  modeling_bamba.BambaModel = PatchedBambaModel
+  modeling_bamba.BambaMixer = PatchedBambaMixer
+  try:
+    yield
+  finally:
+    modeling_bamba.BambaModel = original_model
+    modeling_bamba.BambaMixer = original_mixer
