+# Copyright 2026 The LiteRT Torch Authors.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+# ==============================================================================
+"""FalconH1 (parallel Mamba2 + attention in EVERY layer) LiteRT export patch.
+
+`FalconH1Mixer.torch_forward`'s scan body is byte-identical to granite's
+Mamba2 SSD (verified by diff, 2026-08-13); the wrapper differs in exactly
+three places, all encoded here:
+
+1. `input_states * self.ssm_in_multiplier` before `in_proj`.
+2. `projected_states * self.mup_vector` before the split. ⚠ `mup_vector` is
+   a NON-PERSISTENT buffer registered by `FalconH1Model.__init__` (a bare
+   mixer does not have it — the self-check registers one), and non-persistent
+   init-computed buffers are the classic meta-load zeroing candidate: if the
+   loader ever zeroes it, every mamba branch outputs zero. The model-level
+   parity gate catches that instantly; a zero-check also runs at export time
+   in the patched model forward's first call (python-level, on the real
+   buffer, before tracing).
+3. The gate tail is conditional: `norm(y, gate)` when `config.mamba_rms_norm`
+   else `y * silu(gate)`.
+
+Cache side: every FalconH1 layer is `layer_types[i] == "hybrid"` (a read-only
+config property) — attention KV and mamba conv/recurrent state live at the
+SAME layer index via core/cache.py's LiteRTLMHybridCacheLayer (k_i/v_i +
+mc_i/mr_i). dt clamp is granite's two-sided `time_step_limit` clamp.
+"""
+
+import contextlib
+import inspect
+
+import torch
+from litert_torch.generative.export_hf.model_ext import patches as patches_lib
+from litert_torch.generative.export_hf.model_ext.granitemoehybrid import (
+    patch as granite_patch,
+)
+from transformers.models.falcon_h1 import modeling_falcon_h1
+
+nn = torch.nn
+F = torch.nn.functional
+
+
+class PatchedFalconH1Model(modeling_falcon_h1.FalconH1Model):
+  """Export-friendly FalconH1 model (class swap; persists on the instance)."""
+
+  def train(self, mode: bool = True):
+    # One-time real-buffer check on the eval() transition (runs OUTSIDE
+    # torch.export tracing, after weights are loaded): a zeroed mup_vector
+    # means the meta-load path dropped the non-persistent buffer, and every
+    # mamba branch would silently output zero. Must not live in forward() —
+    # fake-tensor tracing cannot concretize float(buffer.max()).
+    if not mode and not getattr(self, "_litert_mup_checked", False):
+      for module in self.modules():
+        if isinstance(module, PatchedFalconH1Mixer):
+          mv = getattr(module, "mup_vector", None)
+          if (mv is not None and isinstance(mv, torch.Tensor)
+              and not mv.is_meta and float(mv.abs().max()) == 0.0):
+            raise AssertionError(
+                "FalconH1 mup_vector is all-zero (non-persistent buffer lost"
+                " in loading) - the export would be silently degenerate."
+            )
+      self._litert_mup_checked = True
+    return super().train(mode)
+
+  def forward(self, input_ids=None, **kwargs):
+    valid = (input_ids != 0).to(torch.float32) if input_ids is not None else None
+    # FalconH1Model.forward's layer loop drops **kwargs (unlike granite /
+    # nemotron / qwen3.5), so the exporter's k_ts_idx / v_ts_idx never reach
+    # the transposed-attention interface. Stash them on the attention modules;
+    # PatchedFalconH1Attention re-injects them per call.
+    k_ts_idx = kwargs.pop("k_ts_idx", None)
+    v_ts_idx = kwargs.pop("v_ts_idx", None)
+    for module in self.modules():
+      if isinstance(module, PatchedFalconH1Mixer):
+        module._litert_valid = valid
+      if isinstance(module, PatchedFalconH1Attention):
+        module._litert_k_ts_idx = k_ts_idx
+        module._litert_v_ts_idx = v_ts_idx
+    return super().forward(input_ids=input_ids, **kwargs)
+
+
+class PatchedFalconH1Attention(modeling_falcon_h1.FalconH1Attention):
+  """Re-injects the exporter's timestamp-index kwargs dropped by the model."""
+
+  def forward(self, *args, **kwargs):
+    if getattr(self, "_litert_k_ts_idx", None) is not None:
+      kwargs.setdefault("k_ts_idx", self._litert_k_ts_idx)
+      kwargs.setdefault("v_ts_idx", self._litert_v_ts_idx)
+    return super().forward(*args, **kwargs)
+
+
+def _folded_torch_forward_falcon(
+    self, input_states, cache_params=None, attention_mask=None
+):
+  """granite's folded rank<=4 SSD scan on FalconH1Mixer.
+
+  Deltas vs granite's _folded_torch_forward: ssm_in_multiplier, mup_vector,
+  and the conditional gate tail. Everything else — including the pad guard
+  with its keepdim rank-0 trap and the one-hot conv-window store — is
+  granite's, via its module.
+  """
+  del attention_mask  # the pad mask arrives via `_litert_valid`
+  _repeat_groups = granite_patch._repeat_groups
+  _repeat_groups_step = granite_patch._repeat_groups_step
+  _zeros_cat = granite_patch._zeros_cat
+  _cumsum_last = granite_patch._cumsum_last
+  _exp_segment_sum_from_cumsum = granite_patch._exp_segment_sum_from_cumsum
+
+  batch_size, seq_len, _ = input_states.shape
+  dtype = input_states.dtype
+  H, P, N = self.num_heads, self.head_dim, self.ssm_state_size
+  n_groups = self.n_groups
+  rep = H // n_groups
+
+  valid = getattr(self, "_litert_valid", None)
+  if valid is not None and seq_len > 1:
+    valid = valid.to(dtype)
+    input_states = input_states * valid[..., None]
+  else:
+    valid = None
+
+  input_states = input_states * self.ssm_in_multiplier  # FalconH1 delta 1
+  projected_states = self.in_proj(input_states)
+  projected_states = projected_states * self.mup_vector  # FalconH1 delta 2
+  gate, hidden_states_B_C, dt = projected_states.split(
+      [self.intermediate_size, self.conv_dim, self.num_heads], dim=-1
+  )
+  hidden_states_B_C = hidden_states_B_C.transpose(1, 2)
+
+  if valid is not None:
+    dt = dt * valid[..., None] + (1.0 - valid[..., None]) * granite_patch._PAD_DT
+
+  use_precomputed_states = cache_params is not None and cache_params.has_previous_state(
+      self.layer_idx
+  )
+  if use_precomputed_states:
+    conv_state = cache_params.layers[self.layer_idx].conv_states[0]
+
+  single_step = use_precomputed_states and seq_len == 1
+
+  if single_step:
+    conv_states = cache_params.update_conv_state(hidden_states_B_C, self.layer_idx)[
+        ..., -self.conv_kernel_size :
+    ]
+    hidden_states_B_C = torch.sum(
+        conv_states * self.conv1d.weight.squeeze(1), dim=-1
+    )
+    if self.use_conv_bias:
+      hidden_states_B_C = hidden_states_B_C + self.conv1d.bias
+    hidden_states_B_C = self.act(hidden_states_B_C)
+  else:
+    if use_precomputed_states:
+      hidden_states_B_C = torch.cat([conv_state, hidden_states_B_C], dim=-1)
+    if cache_params is not None:
+      if valid is not None:
+        _w = hidden_states_B_C.shape[-1]
+        _K = self.conv_kernel_size
+        _seq = valid.shape[-1]
+        _lead = torch.zeros(
+            hidden_states_B_C.shape[:-1] + (_K,),
+            device=hidden_states_B_C.device,
+            dtype=hidden_states_B_C.dtype,
+        )
+        _padded = torch.cat([_lead, hidden_states_B_C], dim=-1)
+        # KEEP THE BATCH DIMENSION; float32 index math (see granite patch).
+        _valid_len = valid.sum(-1, keepdim=True).to(_padded.dtype)  # (B, 1)
+        _base = float(_w - _seq) + _valid_len  # (B, 1)
+        _idx = _base + torch.arange(
+            _K, device=_padded.device, dtype=_padded.dtype
+        )  # (B, K)
+        _cols = torch.arange(
+            _w + _K, device=_padded.device, dtype=_padded.dtype
+        )  # (P,)
+        _sel = torch.relu(
+            1.0 - torch.abs(_cols[None, :, None] - _idx[:, None, :])
+        )  # (B, P, K)
+        conv_states = torch.matmul(_padded, _sel)
+      else:
+        conv_states = F.pad(
+            hidden_states_B_C,
+            (self.conv_kernel_size - hidden_states_B_C.shape[-1], 0),
+        )
+      cache_params.update_conv_state(conv_states, self.layer_idx)
+
+    hidden_states_B_C = self.act(
+        self.conv1d(hidden_states_B_C)[..., : hidden_states_B_C.shape[-1]]
+    )
+    if use_precomputed_states:
+      hidden_states_B_C = hidden_states_B_C[..., -seq_len:]
+    hidden_states_B_C = hidden_states_B_C.transpose(1, 2)
+
+  if valid is not None:
+    hidden_states_B_C = hidden_states_B_C * valid[..., None]
+
+  hidden_states, B, C = torch.split(
+      hidden_states_B_C,
+      [self.intermediate_size, n_groups * N, n_groups * N],
+      dim=-1,
+  )
+
+  A = -torch.exp(self.A_log.float())  # (H,)
+
+  if single_step:
+    dt = F.softplus(dt[:, 0, :] + self.dt_bias)  # (b, H)
+    dt = torch.clamp(dt, self.time_step_limit[0], self.time_step_limit[1])
+    dA = torch.exp(dt * A)  # (b, H)
+
+    x = hidden_states.reshape(batch_size, H, P)  # (b, H, P)
+    if n_groups == 1:
+      Bh = B.reshape(batch_size, 1, N)
+      Ch = C.reshape(batch_size, 1, N)
+    elif rep > 1:
+      Bh = _repeat_groups_step(B, n_groups, rep, N)  # (b, H, N)
+      Ch = _repeat_groups_step(C, n_groups, rep, N)
+    else:
+      Bh = B.reshape(batch_size, H, N)
+      Ch = C.reshape(batch_size, H, N)
+
+    dBx = dt[:, :, None, None] * Bh[:, :, None, :] * x[:, :, :, None]  # (b,H,P,N)
+    prev = cache_params.layers[self.layer_idx].recurrent_states[0]
+    ssm_state = prev.to(dBx.dtype) * dA[:, :, None, None] + dBx
+    ssm_state = cache_params.update_recurrent_state(ssm_state, self.layer_idx)
+
+    y = (ssm_state.to(Ch.dtype) * Ch[:, :, None, :]).sum(-1)  # (b, H, P)
+    y = y + x * self.D[None, :, None]
+    y = y.reshape(batch_size, -1)[:, None, ...]  # (b, 1, intermediate)
+  else:
+    cl = self.chunk_size
+    pad_size = (cl - seq_len % cl) % cl
+    seq_p = seq_len + pad_size
+    c = seq_p // cl
+
+    dt = F.softplus(dt + self.dt_bias)  # (b, seq, H)
+    dt = torch.clamp(dt, self.time_step_limit[0], self.time_step_limit[1])
+
+    hidden_states = hidden_states.reshape(batch_size, seq_len, -1, P).float()
+    B = B.reshape(batch_size, seq_len, -1, N).float()
+    C = C.reshape(batch_size, seq_len, -1, N).float()
+    if rep > 1:
+      B = _repeat_groups(B, rep)
+      C = _repeat_groups(C, rep)
+
+    D_residual = self.D[..., None] * hidden_states  # (b, seq, H, P)
+    hidden_states = hidden_states * dt[..., None]
+    A = A.to(hidden_states.dtype) * dt  # (b, seq, H)
+
+    if pad_size > 0:
+      hidden_states = _zeros_cat(hidden_states, pad_size, 1)
+      B = _zeros_cat(B, pad_size, 1)
+      C = _zeros_cat(C, pad_size, 1)
+      A = _zeros_cat(A, pad_size, 1)
+
+    def fold(t, last):  # (b, seq_p, H, last) -> (b*H*c, cl, last)
+      return t.permute(0, 2, 1, 3).reshape(batch_size * H * c, cl, last)
+
+    xf = fold(hidden_states, P)
+    bf = fold(B, N)
+    cf = fold(C, N)
+    af = A.permute(0, 2, 1).reshape(batch_size * H * c, cl)
+
+    a_cumsum = _cumsum_last(af)  # (bhc, cl)
+    Lf = _exp_segment_sum_from_cumsum(a_cumsum)  # (bhc, cl, cl)
+
+    G = torch.matmul(cf, bf.transpose(1, 2))  # (bhc, cl, cl)
+    M = G * Lf
+    Y_diag = torch.matmul(M, xf)  # (bhc, cl, P)
+
+    decay_states = torch.exp(a_cumsum[:, -1:] - a_cumsum)  # (bhc, cl)
+    B_decay = bf * decay_states[..., None]
+    states = torch.matmul(B_decay.transpose(1, 2), xf)  # (bhc, N, P)
+
+    states_bh = states.reshape(batch_size * H, c, N * P)
+    if use_precomputed_states:
+      prev = cache_params.layers[self.layer_idx].recurrent_states[0]  # (b,H,P,N)
+      prev = (
+          prev.to(states_bh.dtype)
+          .permute(0, 1, 3, 2)
+          .reshape(batch_size * H, 1, N * P)
+      )
+    else:
+      prev = torch.zeros_like(states_bh[:, :1])
+    states_bh = torch.cat([prev, states_bh], dim=1)  # (bH, c+1, N*P)
+
+    chunk_tail = a_cumsum[:, -1].reshape(batch_size * H, c)
+    chunk_tail = torch.cat(
+        [torch.zeros_like(chunk_tail[:, :1]), chunk_tail], dim=1
+    )  # (bH, c+1)
+    decay_chunk = _exp_segment_sum_from_cumsum(
+        _cumsum_last(chunk_tail)
+    )  # (bH, c+1, c+1)
+    new_states = torch.matmul(decay_chunk, states_bh)  # (bH, c+1, N*P)
+    states_out, ssm_state = new_states[:, :-1], new_states[:, -1]
+
+    st = states_out.reshape(batch_size * H * c, N, P)
+    Y_off = torch.matmul(cf, st) * torch.exp(a_cumsum)[..., None]  # (bhc, cl, P)
+
+    y = Y_diag + Y_off
+    y = y.reshape(batch_size, H, seq_p, P).permute(0, 2, 1, 3)  # (b, seq_p, H, P)
+    if pad_size > 0:
+      y = y[:, :seq_len]
+    y = (y + D_residual).reshape(batch_size, seq_len, -1)
+
+    if cache_params is not None:
+      ssm_state = ssm_state.reshape(batch_size, H, N, P).permute(0, 1, 3, 2)
+      cache_params.update_recurrent_state(ssm_state, self.layer_idx)
+
+  # FalconH1 delta 3: conditional gate tail.
+  if self.mamba_rms_norm:
+    scan_output = self.norm(y, gate)
+  else:
+    scan_output = y * F.silu(gate)
+  return self.out_proj(scan_output.to(dtype))
+
+
+class PatchedFalconH1Mixer(modeling_falcon_h1.FalconH1Mixer):
+  torch_forward = _folded_torch_forward_falcon
+
+
+def _assert_scan_body_unchanged():
+  """The reuse contract: FalconH1's scan must still be granite's scan.
+
+  The wrapper differs (multipliers, norm tail), so unlike bamba this cannot
+  assert byte identity of the whole method; instead it anchors on the scan's
+  load-bearing lines staying present verbatim.
+  """
+  src = inspect.getsource(modeling_falcon_h1.FalconH1Mixer.torch_forward)
+  for anchor in (
+      "projected_states = projected_states * self.mup_vector",
+      "input_states = input_states * self.ssm_in_multiplier",
+      "torch.clamp(dt, self.time_step_limit[0], self.time_step_limit[1])",
+      "decay_chunk = torch.exp(segment_sum(nn.functional.pad(A_cumsum[:, :, :, -1], (1, 0))))",
+  ):
+    if anchor not in src:
+      raise AssertionError(
+          f"FalconH1Mixer.torch_forward lost anchor {anchor!r}; the upstream "
+          "scan changed - re-verify the folded port before exporting."
+      )
+
+
+def _selfcheck_folded_falcon(tol=2e-4):
+  """Run the folded scan against the installed FalconH1Mixer."""
+  from transformers.models.falcon_h1.configuration_falcon_h1 import (
+      FalconH1Config,
+  )
+
+  torch.manual_seed(0)
+  cfg = FalconH1Config(
+      hidden_size=64,
+      num_hidden_layers=1,
+      mamba_n_heads=8,
+      mamba_d_state=16,
+      mamba_expand=2,
+      mamba_chunk_size=8,
+      mamba_n_groups=2,
+      mamba_d_conv=4,
+      num_attention_heads=4,
+      num_key_value_heads=2,
+  )
+  layer = modeling_falcon_h1.FalconH1Mixer(cfg, layer_idx=0).eval().float()
+  # mup_vector is registered by FalconH1Model.__init__, not the mixer — give
+  # the bare mixer a non-trivial one so the port's multiply is exercised.
+  proj = layer.in_proj.out_features
+  layer.register_buffer(
+      "mup_vector", 0.5 + torch.rand(1, 1, proj), persistent=False
+  )
+  worst = 0.0
+  for seq in (16, 13):
+    x = torch.randn(1, seq, cfg.hidden_size)
+    with torch.no_grad():
+      ref = modeling_falcon_h1.FalconH1Mixer.torch_forward(layer, x)
+      new = _folded_torch_forward_falcon(layer, x)
+    worst = max(worst, (ref - new).abs().max().item() / ref.abs().max().item())
+  if worst > tol:
+    raise AssertionError(
+        "FalconH1 folded SSD disagrees with the installed transformers "
+        f"implementation (relative max|diff| {worst:.2e} > {tol:.0e})."
+    )
+  return worst
+
+
+@patches_lib.register_patch(["falcon_h1"])
+@contextlib.contextmanager
+def falcon_h1_litert_patch():
+  _assert_scan_body_unchanged()
+  rel = _selfcheck_folded_falcon()
+  print(
+      "FalconH1 patch applied (granite folded rank<=4 SSD + pad guard, "
+      f"mup/ssm multipliers + conditional gate tail; self-check rel {rel:.1e})."
+  )
+  original_model = modeling_falcon_h1.FalconH1Model
+  original_mixer = modeling_falcon_h1.FalconH1Mixer
+  original_attn = modeling_falcon_h1.FalconH1Attention
+  modeling_falcon_h1.FalconH1Model = PatchedFalconH1Model
+  modeling_falcon_h1.FalconH1Mixer = PatchedFalconH1Mixer
+  modeling_falcon_h1.FalconH1Attention = PatchedFalconH1Attention
+  try:
+    yield
+  finally:
+    modeling_falcon_h1.FalconH1Model = original_model
+    modeling_falcon_h1.FalconH1Mixer = original_mixer
+    modeling_falcon_h1.FalconH1Attention = original_attn
