{%- macro format_content(content) -%}
    {%- if content is string -%}
        {{- content -}}
    {%- elif content is sequence -%}
        {%- for item in content -%}
            {%- if item['type'] == 'text' -%}
                {{- item['text'] -}}
            {%- endif -%}
        {%- endfor -%}
    {%- endif -%}
{%- endmacro -%}
{#- mlboydaisuke/Llama-3.2-3B-Instruct-LiteRT -- the vendor's default system turn, restored (2026-08-28).

    The upstream chat template emits this block whenever the caller sends no
    system message. litert_torch's parse_chat_template probes the template with a
    system message already present, so the block is never rendered during probing
    and never reached the bundle. It is put back verbatim below, and fires once per
    conversation -- the engine renders the whole history through this template on
    every turn -- and not at all when the caller supplies a system message.
-#}
{%- if messages[0].role != 'system' -%}{{ "<|start_header_id|>system<|end_header_id|>\n\nCutting Knowledge Date: December 2023\nToday Date: " ~ strftime_now("%d %b %Y") ~ "\n\n<|eot_id|>" }}{%- endif -%}{%- for message in messages -%}{%- if message.role == 'user' %}<|start_header_id|>user<|end_header_id|>

{{ format_content(message.content) }}<|eot_id|>{% endif -%}{%- if message.role == 'model' or message.role == 'assistant' %}<|start_header_id|>assistant<|end_header_id|>

{{ format_content(message.content) }}<|eot_id|>{% endif -%}{%- if message.role == 'system' %}<|start_header_id|>system<|end_header_id|>

{{ format_content(message.content) }}<|eot_id|>{% endif -%}{%- endfor -%}{%- if add_generation_prompt %}<|start_header_id|>assistant<|end_header_id|>

{% endif -%}