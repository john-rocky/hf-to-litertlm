     return super().forward(input_ids=input_ids, **kwargs)
 
 
+def _vendor_dt_limit(dt, limit):
+  """NVIDIA's dt limit on softplus(dt + dt_bias): clamp to config.time_step_limit.
+
+  The model repo's modeling_nemotron_h.py clamps to time_step_limit (l.573 /
+  l.622, default (0.0, inf)) and hands no dt_limit to the CUDA kernels for that
+  default (l.425); transformers 5.14.1 floors at time_step_min instead. A bound
+  that cannot bind on a softplus output (lo <= 0, hi = inf) emits no op.
+  """
+  lo, hi = limit if limit is not None else (0.0, float("inf"))
+  if lo > 0.0:
+    dt = torch.clamp(dt, min=lo)
+  if hi != float("inf"):
+    dt = torch.clamp(dt, max=hi)
+  return dt
+
