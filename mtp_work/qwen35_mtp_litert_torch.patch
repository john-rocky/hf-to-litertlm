+import glob
+import os
+
+from litert_torch.generative.export_hf.core import exportable_module as base_exportable_module
+from litert_torch.generative.export_hf.core.external_emb import exportable_module as external_emb_module
+import litert_torch.generative.custom_ops.dynamic_update_slice as tfl_dus
+import torch
+from transformers.models.qwen3_5 import modeling_qwen3_5
+
+
+def _find_mtp_tensors(model_path: str) -> dict[str, torch.Tensor]:
+  """Loads the 15 `mtp.*` tensors straight from safetensors.
+
+  transformers 5.14 drops them on load (`_keys_to_ignore_on_load_unexpected`
+  contains ^mtp.*), so the loaded model cannot supply them.
+  """
+  from safetensors import safe_open  # pylint: disable=g-import-not-at-top
