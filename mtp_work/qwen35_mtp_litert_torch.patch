+    with safe_open(shard, framework="pt") as f:
+      for key in f.keys():
+        if key.startswith("mtp."):
+          tensors[key] = f.get_tensor(key).to(torch.float32)
+  assert tensors, f"no mtp.* tensors in {model_path} — not an MTP checkpoint"
+  return tensors
+
+
+class _MtpPairWriter(torch.nn.Module):
+  """Computes the drafter's teacher-forced K/V rows for a span of positions.
+
+  Semantics verified against vLLM qwen3_5_mtp + the P0 alpha oracle
+  (`mtp_work/qwen35_mtp_alpha_oracle.py::teacher_and_step1`): the drafter-layer
+  input at slot q is fc(cat(ne(emb(t_{q+1})), nh(h_q))); its k goes through
+  input_layernorm -> k_proj -> per-head k_norm -> RoPE at position q; v through
+  input_layernorm -> v_proj.
+  """
+
+  def __init__(self, text_config, mtp_tensors, rotary_emb):
+    super().__init__()
+    hidden = text_config.hidden_size
+    eps = text_config.rms_norm_eps
+    self.num_kv_heads = text_config.num_key_value_heads
+    self.head_dim = text_config.head_dim
+    self.rotary_emb = rotary_emb
+    rms = modeling_qwen3_5.Qwen3_5RMSNorm
+    self.ne = rms(hidden, eps=eps)
+    self.nh = rms(hidden, eps=eps)
+    self.fc = torch.nn.Linear(2 * hidden, hidden, bias=False)
+    self.ln = rms(hidden, eps=eps)
+    kv_out = self.num_kv_heads * self.head_dim
+    self.k_proj = torch.nn.Linear(hidden, kv_out, bias=False)
+    self.v_proj = torch.nn.Linear(hidden, kv_out, bias=False)
+    self.k_norm = rms(self.head_dim, eps=eps)
+    with torch.no_grad():
+      self.ne.weight.copy_(mtp_tensors["mtp.pre_fc_norm_embedding.weight"])
+      self.nh.weight.copy_(mtp_tensors["mtp.pre_fc_norm_hidden.weight"])
+      self.fc.weight.copy_(mtp_tensors["mtp.fc.weight"])
+      self.ln.weight.copy_(
+          mtp_tensors["mtp.layers.0.input_layernorm.weight"])
+      self.k_proj.weight.copy_(
+          mtp_tensors["mtp.layers.0.self_attn.k_proj.weight"])
+      self.v_proj.weight.copy_(
+          mtp_tensors["mtp.layers.0.self_attn.v_proj.weight"])
+      self.k_norm.weight.copy_(
+          mtp_tensors["mtp.layers.0.self_attn.k_norm.weight"])
+
+  def forward(self, embeddings, prev_hidden, positions):
+    """embeddings/prev_hidden [1, T, H], positions [T] (slot indices, = rope).
+
+    Returns k rows [1, kv_heads, T, head_dim] (post-norm, post-rope) and
+    v rows [1, kv_heads, head_dim, T] — laid out for the base attention cache
+    (k_ts_idx=2 / v_ts_idx=3).
+    """
+    x = self.fc(torch.cat([self.ne(embeddings), self.nh(prev_hidden)], dim=-1))
+    x = self.ln(x)
+    t = x.shape[1]
+    k = self.k_proj(x).reshape(1, t, self.num_kv_heads, self.head_dim)
+    k = self.k_norm(k).transpose(1, 2)                # [1, kvh, T, hd]
+    v = self.v_proj(x).reshape(1, t, self.num_kv_heads, self.head_dim)
+    pos = positions.reshape(1, -1)
+    cos, sin = self.rotary_emb(x, pos)
+    _, k = modeling_qwen3_5.apply_rotary_pos_emb(k, k, cos, sin)
+    v = v.permute(0, 2, 3, 1)                         # [1, kvh, hd, T]
+    return k, v
+
+
+def _dus(buf, update, index_per_dim):
+  # start_indices are 0-d int32 scalars (the tfl_dus / stablehlo contract).
+  zero = torch.zeros((), dtype=torch.int32)
+  indices = [
+      idx.to(torch.int32).reshape(()) if isinstance(idx, torch.Tensor) else zero
+      for idx in index_per_dim
+  ]
+  return tfl_dus.dynamic_update_slice(buf, update, indices)
+
+
+def _write_pair_kv(k_cache, v_cache, k_rows, v_rows, input_pos):
+  """Writes pair rows for input positions q at drafter slots q-1.
+
+  Row 0 goes alone at (input_pos[0]-1) mod cache_len — the mod folds the
+  phantom slot of a chunk starting at position 0 to the cache's last slot,
+  which the drafter can never attend. Rows 1..T-1 are one contiguous block at
+  slot input_pos[0] (engine chunks are contiguous; pad-tail rows land on
+  future real-token slots and are overwritten when those positions are
+  actually processed, provably before any drafter read).
+  """
+  cache_len = k_cache.shape[2]
+  pos0 = input_pos[0].to(torch.int32)
+  slot0 = torch.remainder(pos0 - 1, cache_len)
+  k_cache = _dus(k_cache, k_rows[:, :, 0:1], [None, None, slot0, None])
+  v_cache = _dus(v_cache, v_rows[:, :, :, 0:1], [None, None, None, slot0])
+  if k_rows.shape[2] > 1:
+    k_cache = _dus(k_cache, k_rows[:, :, 1:], [None, None, pos0, None])
+    v_cache = _dus(v_cache, v_rows[:, :, :, 1:], [None, None, None, pos0])
+  return k_cache, v_cache
+
+
+def _hidden_ring_write_rows(ring, rows, positions):
+  """rows [1, N, H] written at ring slots (positions[j] mod R)."""
+  ring_size = ring.shape[0]
+  for j in range(rows.shape[1]):
+    slot = torch.remainder(positions[j].to(torch.int32), ring_size)
+    ring = _dus(ring, rows[:, j : j + 1], [slot, None, None])
+  return ring
+
+
+def _valid_from_positions(input_pos):
+  """Engine pads prefill chunks with non-increasing positions (the same
+  contract the pad guard's embedder-input fallback uses)."""
+  v0 = torch.ones_like(input_pos[:1], dtype=torch.float32)
+  v1 = (input_pos[1:] > input_pos[:-1]).to(torch.float32)
+  return torch.cat([v0, v1], dim=0)
+
+
+class _MtpModuleMixin:
+  """Shared plumbing for the three MTP signatures."""
+
+  def _init_mtp(self, model, export_config):
+    mtp_cfg = export_config.extra_kwargs["mtp_speculative"]
+    self._num_draft_steps = mtp_cfg["num_draft_steps"]
+    self._ring_size = mtp_cfg["ring_size"]
+    assert self._ring_size >= self._num_draft_steps + 2, (
+        "ring_size must be >= num_draft_steps + 2: the verify write range "
+        "[p..p+G] must not clobber the read slot p-1")
+    cfg = model.config
+    self._text_config = getattr(cfg, "text_config", cfg)
+    tm = self._text_model()
+    mtp_tensors = _find_mtp_tensors(export_config.model)
+    self.mtp_pair = _MtpPairWriter(
+        self._text_config, mtp_tensors, tm.rotary_emb)
+
+  def _text_model(self):
+    m = getattr(self.model, "model", self.model)
+    return getattr(m, "language_model", m)
+
+  def _mtp_state_sample_inputs(self):
+    cfg = self._text_config
+    cache_len = self.export_config.cache_length
+    kv_heads = cfg.num_key_value_heads
+    head_dim = cfg.head_dim
+    return {
+        "kv_cache_k_mtp": torch.zeros(
+            (1, kv_heads, cache_len, head_dim), dtype=torch.float32),
+        "kv_cache_v_mtp": torch.zeros(
+            (1, kv_heads, head_dim, cache_len), dtype=torch.float32),
+        "kv_cache_h_mtp": torch.zeros(
+            (self._ring_size, 1, cfg.hidden_size), dtype=torch.float32),
+    }
+
+  def _run_text_model(self, embeddings, input_pos, kv_cache, mask):
+    inputs = self.adapt_inputs(
+        None,
+        embeddings,
+        input_pos,
+        kv_cache,
+        mask,
+        use_bool_mask=self.export_config.extra_kwargs.get(
+            "use_bool_mask", False
+        ),
+    )
+    inputs |= self.attention_kwargs()
+    output = self._text_model()(**inputs)
+    # last_hidden_state is POST final norm (Qwen3_5TextModel applies self.norm
+    # before returning) — the exact `hidden` the drafter was measured with.
+    return output.last_hidden_state, output.past_key_values
+
+  def _mtp_updates(self, embeddings, input_pos, h, k_mtp, v_mtp, h_ring,
+                   write_all_hidden):
+    """Pair-KV writes + hidden-ring writes shared by all three signatures."""
+    ring_size = h_ring.shape[0]
+    slot_prev = torch.remainder(
+        input_pos[0].to(torch.int32) - 1, ring_size).reshape(1)
+    h_prev0 = torch.index_select(h_ring, 0, slot_prev).permute(1, 0, 2)
+    prev_hidden = torch.cat([h_prev0, h[:, :-1]], dim=1) if h.shape[1] > 1 \
+        else h_prev0
+    k_rows, v_rows = self.mtp_pair(embeddings, prev_hidden, input_pos - 1)
+    k_mtp, v_mtp = _write_pair_kv(k_mtp, v_mtp, k_rows, v_rows, input_pos)
+    if write_all_hidden:
+      h_ring = _hidden_ring_write_rows(h_ring, h, input_pos)
+    else:
+      valid = _valid_from_positions(input_pos)
+      vlen = valid.sum().to(torch.int32)
+      last_idx = (vlen - 1).reshape(1)
+      h_last = torch.index_select(h, 1, last_idx)
+      last_pos = (input_pos[0].to(torch.int32) + vlen - 1).reshape(1)
+      h_ring = _hidden_ring_write_rows(h_ring, h_last, last_pos)
+    return k_mtp, v_mtp, h_ring
+
+
+class Qwen35MtpPrefillExternalEmbedder(
+    _MtpModuleMixin,
+    external_emb_module.LiteRTExportableModuleForDecoderOnlyLMPrefillExternalEmbedder,
+):
+  """Prefill with drafter pair-KV + hidden-ring writes."""
+
+  def __init__(self, model, export_config):
+    super().__init__(model, export_config)
+    self._init_mtp(model, export_config)
+
+  def forward(self, embeddings, input_pos, kv_cache, mask,
+              kv_cache_k_mtp, kv_cache_v_mtp, kv_cache_h_mtp):
+    h, new_kv = self._run_text_model(embeddings, input_pos, kv_cache, mask)
+    k_mtp, v_mtp, h_ring = self._mtp_updates(
+        embeddings, input_pos, h, kv_cache_k_mtp, kv_cache_v_mtp,
+        kv_cache_h_mtp, write_all_hidden=False)
+    return {
+        "kv_cache": new_kv,
+        "kv_cache_k_mtp": k_mtp,
+        "kv_cache_v_mtp": v_mtp,
+        "kv_cache_h_mtp": h_ring,
+    }
+
+  def get_sample_inputs(self, model_config, **kwargs):
+    sample_inputs = super().get_sample_inputs(model_config, **kwargs)
+    state = self._mtp_state_sample_inputs()
+    for _, (inputs, _) in sample_inputs.items():
+      inputs.update({k: v.clone() for k, v in state.items()})
+    return sample_inputs
+
+
+class Qwen35MtpGenerateExternalEmbedder(
+    _MtpModuleMixin,
+    external_emb_module.LiteRTExportableModuleForDecoderOnlyLMGenerateExternalEmbedder,
+):
+  """Decode with fp32 `activations` output (seeds the first draft) and the
+  drafter pair-KV / hidden-ring writes."""
+
+  def __init__(self, model, export_config):
+    super().__init__(model, export_config)
+    self._init_mtp(model, export_config)
+
+  def forward(self, embeddings, input_pos, kv_cache, mask,
+              kv_cache_k_mtp, kv_cache_v_mtp, kv_cache_h_mtp):
+    h, new_kv = self._run_text_model(embeddings, input_pos, kv_cache, mask)
+    logits = self.model.lm_head(h)
+    k_mtp, v_mtp, h_ring = self._mtp_updates(
+        embeddings, input_pos, h, kv_cache_k_mtp, kv_cache_v_mtp,
+        kv_cache_h_mtp, write_all_hidden=True)
+    return {
+        "kv_cache": new_kv,
+        "logits": logits,
+        "activations": h,
+        "kv_cache_k_mtp": k_mtp,
+        "kv_cache_v_mtp": v_mtp,
+        "kv_cache_h_mtp": h_ring,
+    }
+
+  def get_sample_inputs(self, model_config):
+    sample_inputs = super().get_sample_inputs(model_config)
+    state = self._mtp_state_sample_inputs()
+    for _, (inputs, _) in sample_inputs.items():
+      inputs.update({k: v.clone() for k, v in state.items()})
+    return sample_inputs
+
+
+class Qwen35MtpVerify(
+    _MtpModuleMixin,
+    external_emb_module.LiteRTExportableModuleForDecoderOnlyLMPrefillExternalEmbedder,
+):
+  """The `verify` signature: G+1 positions, per-position logits+activations.
+
+  Prefill-shaped (the gated-delta layers take the chunked continuation branch)
+  but with verify_mode cache layers: per-position recurrent/conv ring writes,
+  so a rejection is rolled back by overwrite exactly like attention KV.
+  """
+
+  _decode_mode = False
+  _verify_mode = True
+
+  def __init__(self, model, export_config):
+    super().__init__(model, export_config)
+    self._init_mtp(model, export_config)
+
+  def forward(self, embeddings, input_pos, kv_cache, mask,
+              kv_cache_k_mtp, kv_cache_v_mtp, kv_cache_h_mtp):
+    tm = self._text_model()
+    tm._litert_verify_mode = True  # pylint: disable=protected-access
+    try:
+      h, new_kv = self._run_text_model(embeddings, input_pos, kv_cache, mask)
+    finally:
+      tm._litert_verify_mode = False  # pylint: disable=protected-access
+    logits = self.model.lm_head(h)
+    k_mtp, v_mtp, h_ring = self._mtp_updates(
+        embeddings, input_pos, h, kv_cache_k_mtp, kv_cache_v_mtp,
+        kv_cache_h_mtp, write_all_hidden=True)
+    return {
+        "kv_cache": new_kv,
+        "logits": logits,
+        "activations": h,
+        "kv_cache_k_mtp": k_mtp,
+        "kv_cache_v_mtp": v_mtp,
+        "kv_cache_h_mtp": h_ring,
+    }
+
+  def get_sample_inputs(self, model_config, **kwargs):
+    export_config = self.export_config
+    steps = self._num_draft_steps + 1
+    use_bool_mask = export_config.extra_kwargs.get("use_bool_mask", False)
+    kv_cache_inputs, _ = self.get_sample_kv_cache(model_config)
+    inputs = {
+        "embeddings": torch.ones(
+            (export_config.batch_size, steps, model_config.hidden_size),
+            dtype=torch.float32,
+        ),
+        "input_pos": torch.arange(1, steps + 1, dtype=torch.int32),
+        "mask": torch.ones(
+            (1, 1, steps, export_config.cache_length),
+            dtype=torch.bool if use_bool_mask else torch.float32,
+        ),
+    }
+    inputs.update(kv_cache_inputs)
+    inputs.update(self._mtp_state_sample_inputs())
+    return {"verify": (inputs, {})}
