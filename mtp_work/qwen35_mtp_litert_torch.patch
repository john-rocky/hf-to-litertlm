+    shards = sorted(glob.glob(os.path.join(model_path, "*.safetensors")))
+  else:
+    pat = os.path.expanduser(
+        "~/.cache/huggingface/hub/models--"
+        + model_path.replace("/", "--")
+        + "/snapshots/*/*.safetensors"
+    )
+    shards = sorted(glob.glob(pat))
+  if not shards:
+    try:
+      import huggingface_hub  # pylint: disable=g-import-not-at-top
+
+      index = huggingface_hub.hf_hub_download(
+          model_path, filename="model.safetensors.index.json"
+      )
+      shards = sorted(glob.glob(os.path.join(os.path.dirname(index),
+                                             "*.safetensors")))
+    except Exception:  # pylint: disable=broad-exception-caught
+      shards = []
+  assert shards, f"no safetensors found for {model_path}"
