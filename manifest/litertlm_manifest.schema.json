{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "litertlm_manifest.schema.json",
  "title": "litertlm_manifest",
  "type": "object",
  "required": ["manifest_schema", "repo", "generated", "model", "variants"],
  "additionalProperties": true,
  "properties": {
    "manifest_schema": {"type": "string", "pattern": "^0\\.1\\.\\d+$"},
    "repo": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "generated": {"type": "string", "format": "date"},
    "generator": {"type": "string"},
    "model": {
      "type": "object",
      "required": ["display_name"],
      "additionalProperties": true,
      "properties": {
        "display_name": {"type": "string"},
        "base_model": {"type": "string"},
        "architecture": {"type": "string"},
        "parameters_b": {"type": "number"},
        "license": {"type": "string"},
        "context_length": {"type": "integer", "minimum": 1},
        "capabilities": {
          "type": "object",
          "properties": {
            "vision": {"type": "boolean"},
            "audio": {"type": "boolean"},
            "thinking": {
              "type": "object",
              "properties": {
                "declared": {"type": "boolean"},
                "channel": {
                  "type": "object",
                  "properties": {"start": {"type": "string"}, "end": {"type": "string"}}
                }
              }
            }
          }
        },
        "session_defaults": {"type": "object"}
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "quantization", "backends"],
        "additionalProperties": true,
        "properties": {
          "file": {"type": "string", "pattern": "\\.litertlm$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "quantization": {"type": "string"},
          "backends": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["cpu", "gpu", "npu"]}
          },
          "default_backend": {"enum": ["cpu", "gpu", "npu"]},
          "min_runtime_version": {"type": "string"},
          "recommended": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["platform", "backend"],
              "properties": {
                "platform": {"enum": ["android", "ios", "macos", "windows", "linux"]},
                "device_class": {"type": "string"},
                "backend": {"enum": ["cpu", "gpu", "npu"]},
                "reason": {"type": "string"}
              }
            }
          },
          "requirements": {
            "type": "object",
            "properties": {
              "peak_ram_mb": {"type": "integer"},
              "platform_notes": {"type": "array", "items": {"type": "string"}}
            }
          },
          "measured": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["device", "backend", "runtime", "date", "source"],
              "properties": {
                "device": {"type": "string"},
                "os": {"type": "string"},
                "backend": {"enum": ["cpu", "gpu", "npu"]},
                "runtime": {"type": "string"},
                "prompt_tokens": {"type": "integer"},
                "decode_tokens": {"type": "integer"},
                "prefill_tps": {"type": ["number", "string"]},
                "decode_tps": {"type": ["number", "string"]},
                "ttft_s": {"type": ["number", "string"]},
                "max_num_tokens": {"type": "integer"},
                "cache": {"type": "string"},
                "runs": {"type": "integer"},
                "date": {"type": "string", "format": "date"},
                "source": {"type": "string"},
                "evidence": {"type": "string"}
              }
            }
          },
          "known_issues": {"type": "array", "items": {"type": "string"}},
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {"type": "string"},
                "size_bytes": {"type": "integer"},
                "model_type": {"type": "string"},
                "backend_constraint": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
