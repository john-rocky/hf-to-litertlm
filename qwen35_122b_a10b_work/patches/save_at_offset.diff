+absl::Status ModelFactory::SaveAt(absl::string_view path, uint64_t offset) {
+  {
+    std::ifstream probe(std::string(path), std::ios::binary | std::ios::ate);
+    if (probe.is_open() && static_cast<uint64_t>(probe.tellg()) > offset) {
+      return absl::InvalidArgumentError(
+          "SaveAt: the file is longer than the offset");
+    }
+  }
+  {
+    std::ofstream create(std::string(path), std::ios::binary | std::ios::app);
+    if (!create.is_open()) {
+      return absl::InvalidArgumentError("Could not open output file");
+    }
+  }
+  PrepareBufferData();
+  flatbuffers::FlatBufferBuilder fbb;
+  fbb.Finish(tflite::Model::Pack(fbb, &model_), tflite::ModelIdentifier());
+  LRT_TENSOR_RETURN_IF_ERROR(UpdateBufferData(fbb));
+  // in | out: the file is opened for update ("r+b"), not truncated.
+  std::ofstream output_file(std::string(path),
+                            std::ios::binary | std::ios::in | std::ios::out);
+  if (!output_file.is_open()) {
+    return absl::InvalidArgumentError("Could not open output file");
+  }
+  output_file.seekp(static_cast<std::streamoff>(offset));
+  output_file.write(reinterpret_cast<char*>(fbb.GetBufferPointer()),
+                    fbb.GetSize());
+  LRT_TENSOR_RETURN_IF_ERROR(WriteBufferData(output_file, offset));
+  return absl::OkStatus();
+}
